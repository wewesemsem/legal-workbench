# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://lawyer:lawyer@localhost:55432/lawyer_workbench
# Vitest always uses an isolated sibling DB (…/lawyer_workbench_test) or this override.
# Never point TEST_DATABASE_URL at the live corpus database.
# TEST_DATABASE_URL=postgresql://lawyer:lawyer@localhost:55432/lawyer_workbench_test
# Optional offline Constitution restore/ingest snapshot (JSON). Used by corpus ingest.
# LEGAL_CORPUS_CONSTITUTION_SNAPSHOT_PATH=.data/storage/legal-corpus/.../constitution.bin

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Rate limiting (auth endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Email delivery
EMAIL_PROVIDER=console
EMAIL_FROM=Legal Workbench <onboarding@localhost>
# RESEND_API_KEY=re_xxx
# Set false to skip verify-email after signup (staging/demo).
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_MS=86400000
EMAIL_RESEND_RATE_LIMIT_WINDOW_MS=900000
EMAIL_RESEND_RATE_LIMIT_MAX_ATTEMPTS=3

# Object storage
# local = filesystem under LOCAL_STORAGE_PATH (default for tests/dev)
# s3    = MinIO/S3 compatible
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lawyer-workbench
S3_ACCESS_KEY_ID=lawyer
S3_SECRET_ACCESS_KEY=lawyersecret
S3_FORCE_PATH_STYLE=true

# Documents + Document AI
DOCUMENT_MAX_UPLOAD_BYTES=20971520
# mock = local deterministic OCR (default)
# google = Google Cloud Document AI
DOCUMENT_AI_PROVIDER=mock
# GCP_PROJECT_ID=
# GCP_LOCATION=us
# GCP_DOCUMENT_AI_PROCESSOR_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json

# Chat + LLM
# mock = deterministic local responses (default for tests/dev)
# openai | anthropic | gemini = default provider for agents / legal retrieval
# Chat UI has a multi-LLM picker; any provider with an API key below becomes selectable.
# Model lists are fetched live from each vendor; "Latest" resolves dynamically.
LLM_PROVIDER=mock
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CHAT_RECENT_MESSAGE_LIMIT=20
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX_ATTEMPTS=30

# Legal corpus ingestion
# fixture = local pipeline samples / offline snapshots (default; safe for tests/dev)
# live = official public-web acquisition (Constitution/SCC/Amiri; no access bypass)
LEGAL_CORPUS_MODE=fixture
LEGAL_CORPUS_REQUEST_DELAY_MS=1500
LEGAL_CORPUS_REQUEST_TIMEOUT_MS=20000
LEGAL_CORPUS_USER_AGENT=Mozilla/5.0 (compatible; LawyerWorkbenchCorpusBot/0.1; +https://localhost; research; respectful)
# Optional token for /api/admin/legal-corpus/* endpoints
# LEGAL_CORPUS_ADMIN_TOKEN=
#
# Official public acquisition:
#   LEGAL_CORPUS_MODE=live npm run corpus -- ingest parliament-constitution --dry-run
#   LEGAL_CORPUS_MODE=live npm run corpus -- ingest parliament-constitution
#   npm run corpus -- validate <documentId>
#   npm run corpus -- approve <documentId>
#
# Approved real-source import (CLI):
#   npm run corpus -- import --manifest ./fixtures/legal-corpus/example-approved-import/manifest.json --dry-run
#   npm run corpus -- import --manifest ./path/to/manifest.json

# Legal retrieval (PostgreSQL full-text + pgvector). No separate vector database.
# Provider-independent gateway: LegalEmbeddingService → model-gateway → provider.
# mock = deterministic local hash embeddings (default; no API key)
# openai = text-embedding-3-small multilingual embeddings (requires OPENAI_API_KEY)
# LEGAL_EMBEDDING_DIMENSIONS must stay 1536 unless migration 0008 is replaced.
# Phase 9: set LEGAL_EMBEDDING_PROVIDER=openai and re-run: npm run corpus -- index
LEGAL_EMBEDDING_PROVIDER=mock
# LEGAL_EMBEDDING_MODEL=text-embedding-3-small
LEGAL_EMBEDDING_DIMENSIONS=1536
LEGAL_EMBEDDING_VERSION=1
# For synthesized (non-extractive) answers, also set:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
LEGAL_RETRIEVAL_TOP_K=10
LEGAL_KEYWORD_WEIGHT=0.45
LEGAL_VECTOR_WEIGHT=0.55
LEGAL_EXACT_REFERENCE_BOOST=3
LEGAL_DOCUMENT_MATCH_BOOST=0.5
LEGAL_PHRASE_BOOST=1
LEGAL_EVIDENCE_MIN_SCORE=0.2
LEGAL_VECTOR_MIN_SIMILARITY=0.12
LEGAL_CHUNK_MAX_CHARS=4000

# Web research (Phase 10). CORPUS mode works without these.
# brave = Brave Search API (app default; same provider as ScanAndFindIt)
# mock  = tests only (NODE_ENV=test). Do not use mock in development/production.
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_FETCH_CANDIDATES=4
WEB_FETCH_TIMEOUT_MS=12000
WEB_FETCH_MAX_BYTES=1500000
WEB_FETCH_MAX_REDIRECTS=3
# Source authority weights (ranking only; never upgrades secondary to primary)
WEB_AUTHORITY_PRIMARY_OFFICIAL=1
WEB_AUTHORITY_OFFICIAL_COURT=0.95
WEB_AUTHORITY_OFFICIAL_GOVERNMENT=0.9
WEB_AUTHORITY_OFFICIAL_PARLIAMENT=0.9
WEB_AUTHORITY_SECONDARY_LEGAL=0.7
WEB_AUTHORITY_ACADEMIC=0.6
WEB_AUTHORITY_GENERAL_WEB=0.3
WEB_AUTHORITY_SEARCH_RESULT=0.15

# AI agents (Phase 4) — hard limits; no unbounded loops
AGENT_MAX_STEPS=40
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_RETRIES=1
AGENT_MAX_EXECUTION_MS=120000
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX_ATTEMPTS=20
