# Railway staging / demo — copy these into the web service Variables tab.
# DATABASE_URL is usually injected via Railway Postgres variable reference.

NODE_ENV=production

# Set after generating a public domain (Settings → Networking → Generate Domain)
# BETTER_AUTH_URL=https://YOUR-APP.up.railway.app
# NEXT_PUBLIC_APP_URL=https://YOUR-APP.up.railway.app

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Reference Railway Postgres: ${{Postgres.DATABASE_URL}}
# DATABASE_URL=

# Persistent volume mounted at /data/storage (Settings → Volumes)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/storage

# Demo-safe defaults (flip when you want live AI / email)
EMAIL_PROVIDER=console
EMAIL_FROM=Lawyer Workbench <onboarding@localhost>
DOCUMENT_AI_PROVIDER=mock
LLM_PROVIDER=mock
LEGAL_EMBEDDING_PROVIDER=mock
LEGAL_CORPUS_MODE=fixture
WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=

# Optional live-AI flip
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LEGAL_EMBEDDING_PROVIDER=openai
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Lawyer Workbench <noreply@your-domain.com>
